Sub TestEmail()
    Call XuLyEmail(True)
End Sub

Sub GuiEmailHangLoat()
    Dim xn As VbMsgBoxResult
    xn = MsgBox("Ban co chac muon gui email cho TAT CA?", vbYesNo + vbExclamation, "Xac nhan")
    If xn = vbYes Then Call XuLyEmail(False)
End Sub

Sub TrichXuatLink()
    Dim ws As Worksheet
    Dim i As Long, lastRow As Long
    Dim rawLink As String, fullLink As String
    Dim BASE_URL As String
    BASE_URL = "https://f88vn-my.sharepoint.com"
    Set ws = ActiveSheet
    lastRow = ws.Cells(ws.Rows.Count, 5).End(xlUp).Row
    ws.Cells(1, 7).Value = "URL goc"
    For i = 2 To lastRow
        If ws.Cells(i, 5).Hyperlinks.Count > 0 Then
            rawLink = ws.Cells(i, 5).Hyperlinks(1).Address
            Do While Left(rawLink, 3) = "../"
                rawLink = Mid(rawLink, 4)
            Loop
            If Left(rawLink, 4) <> "http" Then
                fullLink = BASE_URL & "/" & rawLink
            Else
                fullLink = rawLink
            End If
            ws.Cells(i, 7).Value = fullLink
        Else
            ws.Cells(i, 7).Value = ws.Cells(i, 5).Value
        End If
    Next i
    MsgBox "Da trich xuat " & (lastRow - 1) & " link ra cot G!", vbInformation
End Sub

Private Sub XuLyEmail(TestMode As Boolean)
    Dim OutApp As Object, OutMail As Object
    Dim ws As Worksheet
    Dim i As Long, lastRow As Long, soGui As Long, soLoi As Long
    Dim tenQLKV As String, khuVuc As String
    Dim emailTo As String, tieuDe As String, linkFile As String
    Dim EmailCC As String
    
    EmailCC = "ngocntm3@f88.vn"
    
    Set ws = ActiveSheet
    lastRow = ws.Cells(ws.Rows.Count, 3).End(xlUp).Row
    
    If lastRow < 2 Then
        MsgBox "Khong tim thay du lieu!", vbExclamation
        Exit Sub
    End If
    
    On Error Resume Next
    Set OutApp = GetObject(, "Outlook.Application")
    If OutApp Is Nothing Then Set OutApp = CreateObject("Outlook.Application")
    On Error GoTo 0
    
    If OutApp Is Nothing Then
        MsgBox "Khong the mo Outlook!", vbCritical
        Exit Sub
    End If
    
    soGui = 0: soLoi = 0
    
    For i = 2 To lastRow
        tenQLKV = Trim(CStr(ws.Cells(i, 1).Value))
        khuVuc = Trim(CStr(ws.Cells(i, 2).Value))
        emailTo = Trim(CStr(ws.Cells(i, 3).Value))
        tieuDe = Trim(CStr(ws.Cells(i, 4).Value))
        
        If ws.Cells(i, 5).Hyperlinks.Count > 0 Then
            linkFile = ws.Cells(i, 5).Hyperlinks(1).Address
            Do While Left(linkFile, 3) = "../"
                linkFile = Mid(linkFile, 4)
            Loop
            If Left(linkFile, 4) <> "http" Then
                linkFile = "https://f88vn-my.sharepoint.com/" & linkFile
            End If
        Else
            linkFile = Trim(CStr(ws.Cells(i, 5).Value))
        End If
        
        If emailTo = "" Or tenQLKV = "" Then GoTo NextRow
        
        On Error Resume Next
        Set OutMail = OutApp.CreateItem(0)
        
        With OutMail
            .To = emailTo
            If EmailCC <> "" Then .CC = EmailCC
            .Subject = tieuDe
            .HTMLBody = TaoHTML(tenQLKV, khuVuc, linkFile)
            
            If TestMode Then
                .Display
                MsgBox "Email mau cho: " & tenQLKV & vbCrLf & "Email: " & emailTo, vbInformation
                Set OutMail = Nothing: Set OutApp = Nothing
                Exit Sub
            Else
                .Send
                soGui = soGui + 1
            End If
        End With
        
        If Err.Number <> 0 Then
            soLoi = soLoi + 1
            ws.Cells(i, 6).Value = "LOI: " & Err.Description
            Err.Clear
        Else
            ws.Cells(i, 6).Value = "Da gui"
        End If
        On Error GoTo 0
        
        Set OutMail = Nothing
        Application.Wait Now + TimeValue("00:00:01")
        Application.StatusBar = "Dang gui... " & soGui & "/" & (lastRow - 1)
NextRow:
    Next i
    
    Application.StatusBar = False
    MsgBox "HOAN TAT!" & vbCrLf & "Da gui: " & soGui & vbCrLf & "Loi: " & soLoi, vbInformation
    Set OutApp = Nothing
End Sub

